# Local-only config (generated by installer; contains secrets)
/config/config.php

# Runtime state
/var/cache/*
/var/log/*
!/var/cache/.gitkeep
!/var/log/.gitkeep

# Composer lockfile is committed; keep vendor too (IONOS shared hosting has no shell)
# /vendor/  ← intentionally NOT ignored

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local state
/.claude/

# PHPUnit
/.phpunit.cache/
/.phpunit.result.cache
