# Local-only config (generated by installer; contains secrets)
/config/config.php

# Runtime state
/var/cache/*
/var/log/*
!/var/cache/.gitkeep
!/var/log/.gitkeep

# Per-tenant uploaded images (runtime data, not project source)
/public/assets/tenants/*
!/public/assets/tenants/.gitkeep

# Production-unsafe debug helpers (created by the installer/troubleshooting,
# never to be committed — display_errors=On exposes stacktraces, the debug
# index.php prints internals on every request)
/public/.user.ini
/public/index.debug.php

# Pasted reference / sample files used while iterating
/Signatur_*.htm
/manifest*.xml

# Personal scratch / notes files at the project root
/Github*
/*.notes
/*.scratch

# Development tooling — kept locally, NOT shipped in the public install
# package. The published repo is a "ready to deploy" bundle: vendor/ is
# pre-built, no composer install or Docker runtime is required to use it.
/CLAUDE.md
/composer.json
/composer.lock
/docker/
/docker-compose.yml
/tests/

# Composer lockfile is committed; keep vendor too (IONOS shared hosting has no shell)
# /vendor/  ← intentionally NOT ignored

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local state
/.claude/

# PHPUnit
/.phpunit.cache/
/.phpunit.result.cache
