{% extends "portal/layout.twig" %}
{% block title %}{{ tenant ? 'Edit tenant' : 'New tenant' }} — SignaturePortal{% endblock %}

{% block sub_nav %}
    {% if tenant %}{% include 'portal/_tenant_nav.twig' with {'tenant': tenant, 'active': 'settings'} %}{% endif %}
{% endblock %}

{% block content %}
<div class="card" style="max-width:720px;">
    <h2>{{ tenant ? 'Edit tenant settings' : 'New tenant' }}</h2>

    {% if errors %}
        <div class="alert alert-error">
            <ul style="margin:0;padding-left:18px;">
                {% for e in errors %}<li>{{ e }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="post" action="{{ tenant ? '/portal/tenants/' ~ tenant.id : '/portal/tenants' }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">

        <label for="name">Name</label>
        <input id="name" name="name" type="text" value="{{ form.name }}" required>

        {% if not tenant %}
        <label for="slug">Slug</label>
        <input id="slug" name="slug" type="text" value="{{ form.slug }}" required pattern="^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$">
        <div class="muted" style="font-size:13px;">Lowercase, alphanumerics and dashes. Used in URLs and the add-in manifest. Cannot be changed later.</div>
        {% endif %}

        <label for="email_domains">Owned email domains</label>
        <textarea id="email_domains" name="email_domains" rows="3" placeholder="acme.com&#10;acme.de">{{ form.email_domains }}</textarea>
        <div class="muted" style="font-size:13px;">One per line, comma, or space. Used to classify recipients as internal or external for rule matching.</div>

        {% if tenant %}
        <h3 style="margin-top:32px;">Legal footer (disclaimer)</h3>
        <p class="muted" style="font-size:13px;">
            Appended to every signature this tenant renders. Useful for HRB/Geschäftsführer/Impressum lines that
            are mandatory in Germany. HTML is sanitized with HTML Purifier on save. Tokens like <code>{email}</code>
            also work here. Leave empty to disable.
        </p>
        <textarea name="disclaimer_html" rows="6" placeholder="&lt;div style=&quot;font-size:11px;color:#888;border-top:1px solid #ddd;margin-top:12px;padding-top:8px;&quot;&gt;&#10;Acme GmbH · Musterstr. 1 · 12345 Berlin · HRB 99999 B · GF: Anna Beispiel&#10;&lt;/div&gt;">{{ form.disclaimer_html }}</textarea>

        <label for="shared_display_mode">Shared mailbox display mode</label>
        <select id="shared_display_mode" name="shared_display_mode">
            <option value="shared"  {% if form.shared_display_mode == 'shared'  %}selected{% endif %}>Shared address — show the team mailbox (e.g. sales@acme.com)</option>
            <option value="primary" {% if form.shared_display_mode == 'primary' %}selected{% endif %}>Primary user — show the composer's real email (e.g. mustermann@acme.com)</option>
            <option value="derived" {% if form.shared_display_mode == 'derived' %}selected{% endif %}>Derived personal — compute an address from the sender's name (e.g. m.mustermann@acme.com)</option>
        </select>
        <div class="muted" style="font-size:13px;">
            Controls the <code>{email}</code> token in the rendered signature when the FROM is a shared mailbox.
            <strong>Shared address</strong> is the Microsoft default — replies land in the team mailbox.
            <strong>Primary user</strong> shows the composer's actual Graph email (the address they could log in with) — real and routable.
            <strong>Derived personal</strong> fabricates a personal-looking alias from the user's name plus the from-domain; the address may or may not exist as a real mailbox.
        </div>
        {% endif %}

        {% if tenant %}
        <h3 style="margin-top:32px;">Microsoft Entra (Azure AD)</h3>
        <p class="muted" style="font-size:13px;">Per-tenant app registration with <code>User.Read.All</code> application permission. Required for live signature delivery (Phase 3) and Entra SSO.</p>

        <label for="entra_tenant_id">Entra tenant ID</label>
        <input id="entra_tenant_id" name="entra_tenant_id" type="text" value="{{ form.entra_tenant_id }}" placeholder="00000000-0000-0000-0000-000000000000">

        <label for="entra_client_id">Entra client ID</label>
        <input id="entra_client_id" name="entra_client_id" type="text" value="{{ form.entra_client_id }}">

        <label for="entra_client_secret">Entra client secret</label>
        <input id="entra_client_secret" name="entra_client_secret" type="password" autocomplete="new-password" placeholder="Leave blank to keep the existing secret">
        <div class="muted" style="font-size:13px;">Stored encrypted at rest with libsodium.</div>

        <h3 style="margin-top:32px;">Single sign-on (Entra OIDC)</h3>
        <p class="muted" style="font-size:13px;">
            Lets portal admins sign in with their Microsoft 365 account. Reuses the Entra app
            registration above. The redirect URI to register in Azure is shown on the tenant
            overview page.
        </p>

        <label class="check-inline">
            <input type="checkbox" name="sso_enabled" value="1" {% if form.sso_enabled %}checked{% endif %}>
            Enable Entra SSO for this tenant
        </label>

        <label class="check-inline">
            <input type="checkbox" name="sso_auto_provision" value="1" {% if form.sso_auto_provision %}checked{% endif %}>
            Auto-provision unknown users on first SSO login
        </label>
        <div class="muted" style="font-size:13px;">
            Off: only users with a matching email address in this tenant's user list can sign in.
            On: any successful Entra sign-in creates a portal user with the role below.
        </div>

        <label for="sso_default_role">Default role for auto-provisioned users</label>
        <select id="sso_default_role" name="sso_default_role">
            <option value="tenant_editor" {% if form.sso_default_role == 'tenant_editor' %}selected{% endif %}>Tenant editor</option>
            <option value="tenant_admin"  {% if form.sso_default_role == 'tenant_admin'  %}selected{% endif %}>Tenant admin</option>
        </select>
        {% endif %}

        <button type="submit" class="btn btn-primary">{{ tenant ? 'Save changes' : 'Create tenant' }}</button>
        {% if tenant and current_user.role == 'superadmin' %}
            <button form="delete-tenant" type="submit" class="btn btn-danger" style="margin-left:8px;"
                onclick="return confirm('Delete this tenant and ALL its templates, rules, and tokens?')">Delete tenant</button>
        {% endif %}
    </form>

    {% if tenant and current_user.role == 'superadmin' %}
    <form id="delete-tenant" method="post" action="/portal/tenants/{{ tenant.id }}/delete" class="inline">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    </form>
    {% endif %}
</div>
{% endblock %}
