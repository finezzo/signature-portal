{% extends "portal/layout.twig" %}
{% block title %}{{ tenant.name }} — SignaturePortal{% endblock %}

{% block sub_nav %}{% include 'portal/_tenant_nav.twig' with {'tenant': tenant, 'active': 'overview'} %}{% endblock %}

{% block content %}
<div class="grid-two">
    <div class="card">
        <h2>Overview</h2>
        <dl class="kv">
            <dt>Name</dt>      <dd>{{ tenant.name }}</dd>
            <dt>Slug</dt>      <dd><code>{{ tenant.slug }}</code></dd>
            <dt>Domains</dt>   <dd>{{ tenant.emailDomains|join(', ') ?: '—' }}</dd>
            <dt>Manifest GUID</dt><dd><code>{{ tenant.manifestGuid ?: '—' }}</code></dd>
            <dt>SSO</dt>       <dd>{% if tenant.ssoEnabled %}enabled ({{ tenant.ssoAutoProvision ? 'auto-provision on' : 'auto-provision off' }}){% else %}disabled{% endif %}</dd>
            <dt>Created</dt>   <dd>{{ tenant.createdAt }}</dd>
            <dt>Updated</dt>   <dd>{{ tenant.updatedAt }}</dd>
        </dl>

        <h2 style="margin-top:32px;">Entra SSO redirect URI</h2>
        <p class="muted" style="font-size:13px;">
            Add this URI to the Entra app registration's <strong>Authentication → Web → Redirect URIs</strong>
            so Microsoft will accept the SSO callback.
        </p>
        <code class="copybox">{{ sso_redirect_uri }}</code>
    </div>

    <div class="card">
        <h2>API key</h2>
        {% if tenant.apiKeyEncrypted %}
            <p>An API key is set. Last rotated: <strong>{{ tenant.apiKeyLastRotatedAt ?: 'unknown' }}</strong>.</p>
            <p class="muted" style="font-size:13px;">For security the key is never displayed after creation. Rotate to produce a new one (the old key stops working immediately and you must redistribute the manifest).</p>
        {% else %}
            <div class="alert alert-error">No API key. Rotate to generate one.</div>
        {% endif %}
        <form method="post" action="/portal/tenants/{{ tenant.id }}/rotate-key" class="inline"
              onsubmit="return confirm('Rotate the API key? The old key stops working immediately.')">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <button type="submit" class="btn btn-primary">Rotate API key</button>
        </form>

        <h2 style="margin-top:32px;">Outlook Add-in manifest</h2>
        {% if tenant.apiKeyEncrypted %}
            <p>Download the OfficeApp manifest XML for this tenant. Upload it via the M365 admin centre or sideload it into Outlook.</p>
            <a class="btn btn-primary" href="/portal/tenants/{{ tenant.id }}/manifest.xml">Download manifest.xml</a>
            <p class="muted" style="font-size:13px;margin-top:12px;">The manifest embeds the tenant slug and API key. Treat it as a secret.</p>
        {% else %}
            <p class="muted">Generate an API key first.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
