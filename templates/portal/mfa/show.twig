{% extends "portal/layout.twig" %}
{% block title %}Two-factor authentication — SignaturePortal{% endblock %}

{% block content %}
<h2>Two-factor authentication</h2>

{% if errors %}
    <div class="alert alert-error">
        <ul style="margin:0;padding-left:18px;">
            {% for e in errors %}<li>{{ e }}</li>{% endfor %}
        </ul>
    </div>
{% endif %}

{% if enrolled %}
<div class="card" style="max-width:560px;">
    <p><span class="badge badge-int">On</span> Every password sign-in also asks for a code from your authenticator app.</p>
    <p class="muted" style="font-size:13px;">Recovery codes left: {{ recovery_left }}. You get new ones by setting up your authenticator again.</p>

    <h3 style="margin-top:32px;">Remove or replace your authenticator</h3>
    {% if required %}
    <p class="muted" style="font-size:13px;">Two-factor authentication is required here, so you will set up a new authenticator right after removing this one.</p>
    {% endif %}
    <form method="post" action="/portal/account/mfa/disable" autocomplete="off">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">

        <label for="current_password">Current password</label>
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>

        <label for="code">Code from your app, or a recovery code</label>
        <input id="code" name="code" type="text" autocomplete="one-time-code" maxlength="32" required>

        <button type="submit" class="btn" style="margin-top:20px;">Remove authenticator</button>
    </form>
</div>
{% else %}
<div class="card" style="max-width:560px;">
    {% if required %}
    <div class="alert alert-error">Set up two-factor authentication to continue using the portal.</div>
    {% endif %}

    <p>Install an authenticator app on your phone, such as Microsoft Authenticator, and add this account with it.</p>

    <h3>1. Scan this code</h3>
    {# Generated by App\Auth\QrCode from numbers only, so it needs no escaping. #}
    <div style="width:220px;">{{ qr_svg|raw }}</div>
    <p class="muted" style="font-size:13px;">Can't scan it? Enter this key by hand: <code>{{ secret }}</code></p>

    <h3 style="margin-top:24px;">2. Confirm</h3>
    <form method="post" action="/portal/account/mfa/enable" autocomplete="off">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">

        <label for="code">6-digit code from the app</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required autofocus>

        <label for="current_password">Current password</label>
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>

        <button type="submit" class="btn btn-primary" style="margin-top:20px;">Turn on</button>
    </form>
</div>
{% endif %}
{% endblock %}
