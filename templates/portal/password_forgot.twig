{% extends "portal/layout.twig" %}
{% block title %}Forgot password — SignaturePortal{% endblock %}
{% block body_class %}auth{% endblock %}

{% block topbar %}{% endblock %}

{% block content %}
<div class="card login-card">
    <h1>Forgot password</h1>

    {% if sent %}
        <div class="alert alert-success">
            If an account exists for that address, a reset link is on its way.
            The link is valid for 30 minutes — also check your spam folder.
        </div>
        <p><a href="/portal/login">Back to sign-in</a></p>
    {% else %}
        <p class="muted">Enter your account email. If it belongs to a local
        account, we'll send a link to choose a new password.</p>

        <form method="post" action="/portal/password/forgot" autocomplete="on">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" required autofocus>

            <button type="submit" class="btn btn-primary">Send reset link</button>
        </form>
        <p style="margin-top:12px;"><a href="/portal/login">Back to sign-in</a></p>
    {% endif %}
</div>
{% endblock %}
