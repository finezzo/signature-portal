{% extends "portal/layout.twig" %}
{% block title %}Reset password — SignaturePortal{% endblock %}
{% block body_class %}auth{% endblock %}

{% block topbar %}{% endblock %}

{% block content %}
<div class="card login-card">
    <h1>Choose a new password</h1>

    {% if not valid %}
        <div class="alert alert-error">
            This reset link is invalid or has expired. Links are valid for
            30 minutes and can only be used once.
        </div>
        <p><a href="/portal/password/forgot">Request a new link</a></p>
    {% else %}
        {% if errors %}
            <div class="alert alert-error">
                <ul style="margin:0;padding-left:18px;">
                    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="post" action="/portal/password/reset" autocomplete="on">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <input type="hidden" name="token" value="{{ token }}">

            <label for="password">New password (min 10 chars)</label>
            <input id="password" name="password" type="password" autocomplete="new-password" required autofocus>

            <label for="password_confirm">Repeat new password</label>
            <input id="password_confirm" name="password_confirm" type="password" autocomplete="new-password" required>

            <button type="submit" class="btn btn-primary">Set new password</button>
        </form>
    {% endif %}
</div>
{% endblock %}
