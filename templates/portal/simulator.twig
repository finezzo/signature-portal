{% extends "portal/layout.twig" %}
{% block title %}Simulator — {{ tenant.name }}{% endblock %}

{% block sub_nav %}{% include 'portal/_tenant_nav.twig' with {'tenant': tenant, 'active': 'simulator'} %}{% endblock %}

{% block content %}
<h2>Simulator</h2>
<p class="muted" style="font-size:13px;">
    Plug in a hypothetical send and see which rule (or override) fires and what the rendered signature looks like.
    Tick <strong>Use live Graph data</strong> to fetch the actual user profile from Microsoft Graph instead of using sample data.
</p>

<div class="grid-two">
    <div class="card">
        <form method="post" action="/portal/tenants/{{ tenant.id }}/simulator">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <label for="from_email">FROM (sender mailbox)</label>
            <input id="from_email" name="from_email" type="email" value="{{ form.from_email }}" required>

            <label for="primary_email">Primary user (optional — for shared-mailbox sends)</label>
            <input id="primary_email" name="primary_email" type="email" value="{{ form.primary_email }}" placeholder="Leave blank if FROM is a personal mailbox">
            <div class="muted" style="font-size:13px;">Used when FROM is a shared mailbox or for matching user overrides.</div>

            <label for="recipients">Recipients</label>
            <textarea id="recipients" name="recipients" rows="3" placeholder="one per line, comma, or space">{{ form.recipients }}</textarea>

            <div class="grid-two" style="margin-top:8px;">
                <div>
                    <label for="language">Language (override)</label>
                    <input id="language" name="language" type="text" value="{{ form.language }}" maxlength="8" placeholder="leave empty for Graph value">
                </div>
                <div>
                    <label for="mailbox_type">Mailbox type (override)</label>
                    <select id="mailbox_type" name="mailbox_type">
                        <option value=""         {{ form.mailbox_type == ''         ? 'selected' : '' }}>(auto from Graph)</option>
                        <option value="personal" {{ form.mailbox_type == 'personal' ? 'selected' : '' }}>Personal</option>
                        <option value="shared"   {{ form.mailbox_type == 'shared'   ? 'selected' : '' }}>Shared</option>
                    </select>
                </div>
            </div>

            <label class="check-inline" style="margin-top:16px;">
                <input type="checkbox" name="use_live_data" value="1" {{ form.use_live_data ? 'checked' : '' }}>
                Use live Graph data (real user profile, not sample tokens)
            </label>
            <div class="muted" style="font-size:12px;">
                Requires the tenant's Entra credentials to be configured. Falls back to sample data if Graph fails.
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:16px;">Simulate</button>
        </form>
    </div>

    <div class="card">
        <h3 style="margin-top:0;">Result</h3>
        {% if result is null %}
            <p class="muted">Submit the form to run a simulation.</p>
        {% else %}
            {% if result.graph_error %}
                <div class="alert alert-error">
                    Graph lookup failed — falling back to sample data.<br>
                    <code style="font-size:12px;">{{ result.graph_error }}</code>
                </div>
            {% endif %}

            {% if result.override %}
                <div class="alert alert-success">
                    User override matched <code>{{ result.override.email }}</code> → template
                    <strong>{{ result.template.name|default('(missing)') }}</strong>
                </div>
                {% if result.override.note %}
                    <p class="muted" style="font-size:13px;">Note: {{ result.override.note }}</p>
                {% endif %}
                <p class="muted" style="font-size:13px;">Rules were not consulted because an override took precedence.</p>
            {% elseif result.rule is null %}
                <div class="alert alert-error">No rule matched. The add-in would not inject a signature.</div>
                <details style="margin-top:12px;">
                    <summary>Why each rule did not match</summary>
                    <ul>
                        {% for r in result.reasons %}
                            <li>Rule #{{ r.rule_id }}: {{ r.why }}</li>
                        {% else %}
                            <li class="muted">No rules defined.</li>
                        {% endfor %}
                    </ul>
                </details>
            {% else %}
                <div class="alert alert-success">
                    Matched rule <strong>#{{ result.rule.id }}</strong> →
                    template <strong>{{ result.template.name|default('(missing)') }}</strong>
                </div>
                <details style="margin-top:8px;">
                    <summary>Per-rule decision trace</summary>
                    <ul>
                        {% for r in result.reasons %}
                            <li>Rule #{{ r.rule_id }}: {{ r.ok ? '✓ matched' : '✗ ' ~ r.why }}</li>
                        {% endfor %}
                    </ul>
                </details>
            {% endif %}

            <dl class="kv" style="margin-top:12px;">
                <dt>From-domain</dt>      <dd><code>{{ result.context.fromDomain }}</code></dd>
                <dt>Recipients</dt>       <dd>{{ result.recipients|join(', ') ?: '(none)' }}</dd>
                <dt>Language</dt>         <dd>{{ result.context.language ?: '—' }}</dd>
                <dt>Mailbox type</dt>     <dd>
                    {{ result.context.mailboxType ?: '—' }}
                    {% if result.is_shared %}<span class="badge">shared mailbox detected</span>{% endif %}
                </dd>
                <dt>Token data</dt>       <dd>
                    {% if result.token_source == 'graph' %}
                        <span class="badge badge-int">live Graph profile</span>
                        {% if result.live_email %}<br><code style="font-size:12px;">{email} → {{ result.live_email }}</code>{% endif %}
                    {% else %}
                        <span class="badge">sample data</span>
                    {% endif %}
                </dd>
            </dl>
        {% endif %}
    </div>
</div>

{% if result and result.rendered_html %}
<div style="margin-top:24px;">
    <h3>Rendered signature{% if result.token_source == 'graph' %} <span class="muted" style="font-size:13px;font-weight:normal;">— with live Graph data</span>{% endif %}</h3>
    <iframe sandbox="allow-same-origin"
            srcdoc="{{ result.rendered_html|e('html_attr') }}"
            style="width:100%;height:300px;border:1px solid var(--border);border-radius:6px;background:#fff;"></iframe>
</div>
{% endif %}
{% endblock %}
