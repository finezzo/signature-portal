{
    "name": "supplymarket/signature-portal",
    "description": "Self-hosted email signature management for Microsoft 365, designed for shared PHP hosting.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "twig/twig": "^3.8",
        "slim/twig-view": "^3.3",
        "ezyang/htmlpurifier": "^4.16",
        "league/oauth2-client": "^2.7",
        "thenetworg/oauth2-azure": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
