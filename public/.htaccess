# Block directory listings — protects /assets/tenants/<slug>/ from being browsable.
Options -Indexes

# Front controller — route everything that's not a real file/dir to index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to the installer while config/config.php does not exist.
    RewriteRule ^install\.php$ - [L]

    # Static files and directories pass through.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → front controller.
    RewriteRule . /index.php [L]
</IfModule>

# Hardening headers (the portal CSP is set by SecurityHeadersMiddleware in PHP).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
