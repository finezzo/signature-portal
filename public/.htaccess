# Block directory listings — protects /assets/tenants/<slug>/ from being browsable.
Options -Indexes

# Front controller — route everything that's not a real file/dir to index.php.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # The debug front controller must never answer, even if it gets uploaded again.
    RewriteRule ^index\.debug\.php$ - [R=404,L]

    # Dotfiles (.DS_Store, .user.ini, ...) are never served.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]

    # The portal is HTTPS only: the login form posts passwords. Deliberately not
    # applied to /addin and /api/sig (manifests always use https there), so a host
    # that reports TLS oddly can at worst affect the admin UI, never signature
    # delivery. Any one of the three signals is enough to count as already secure.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(portal(/.*)?)?$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Allow direct access to the installer while config/config.php does not exist.
    RewriteRule ^install\.php$ - [L]

    # Static files and directories pass through.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → front controller.
    RewriteRule . /index.php [L]
</IfModule>

# Hardening headers (the portal CSP is set by SecurityHeadersMiddleware in PHP).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
