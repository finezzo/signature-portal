# Defense-in-depth: var/ (sessions, caches, logs) lives OUTSIDE the public/
# docroot and must never be web-served. Denies HTTP access should the docroot
# ever be misconfigured to the repo root. Covers both Apache 2.2 and 2.4.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
